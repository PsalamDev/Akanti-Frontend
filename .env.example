# API base URL used by the frontend (src/services/api.js).
#
# Leave this unset in production: requests go to /api and Vercel rewrites them
# to the backend (see vercel.json). Set it only if you want the browser to call
# the backend origin directly (the backend's CORS must then allow this origin):
#   VITE_API_URL=https://akanti-backend.onrender.com/api
VITE_API_URL=
